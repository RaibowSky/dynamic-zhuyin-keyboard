<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Taiwan Zhuyin Keyboard"
        android:textSize="13sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="28dp"/>

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_launcher"
        android:layout_marginBottom="28dp"
        android:contentDescription="Keyboard icon"/>

    <TextView
        android:id="@+id/tv_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="7dp"
        android:gravity="left"
        android:layout_marginBottom="28dp"
        android:background="@drawable/info_box_bg"
        android:padding="20dp"/>

    <Button
        android:id="@+id/btn_enable_keyboard"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="開啟鍵盤設定"
        android:textSize="15sp"
        android:textColor="@color/color_on_primary"
        android:backgroundTint="@color/color_primary"
        android:layout_marginBottom="10dp"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btn_switch_keyboard"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="切換鍵盤"
        android:textSize="15sp"
        android:textColor="@color/color_on_secondary"
        android:backgroundTint="@color/color_secondary"
        android:textAllCaps="false"/>

</LinearLayout>
